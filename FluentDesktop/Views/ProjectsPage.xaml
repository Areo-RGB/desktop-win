<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentDesktop.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FluentDesktop.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:FluentDesktop.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Header, Mode=OneWay}" />
                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.RootText, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" Click="Rescan_Click" IsEnabled="{x:Bind helpers:Bind.Not(ViewModel.IsScanning), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Grid Width="14" Height="14">
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                        <FontIcon FontSize="14" Glyph="&#xE72C;" Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.IsScanning), Mode=OneWay}" />
                    </Grid>
                    <TextBlock Text="Rescan" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search projects" QueryIcon="Find" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <toolkit:Segmented Grid.Column="1" SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}">
                <toolkit:SegmentedItem Content="All" />
                <toolkit:SegmentedItem Content="Flutter" />
                <toolkit:SegmentedItem Content="Web" />
                <toolkit:SegmentedItem Content="Android" />
                <toolkit:SegmentedItem Content="Other" />
            </toolkit:Segmented>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <Grid>
                <TextBlock
                    Margin="0,40"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryCaptionStyle}"
                    Text="No projects match. Change the filter or rescan the Projects folder (Settings, Folders)."
                    Visibility="{x:Bind helpers:Bind.VisibleIfNone(ViewModel.Visible.Count), Mode=OneWay}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Visible}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="12" MinItemWidth="420" MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectItem">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind KindGlyph}" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2" BorderBrush="{x:Bind helpers:Bind.Success}" Style="{StaticResource PillBorderStyle}" Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                            <TextBlock FontSize="11" Foreground="{x:Bind helpers:Bind.Success}" Text="Running" />
                                        </Border>
                                        <Border Grid.Column="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Style="{StaticResource PillBorderStyle}">
                                            <TextBlock FontSize="11" Text="{x:Bind Kind}" />
                                        </Border>
                                        <Button Grid.Column="4" Click="Hide_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Hide project">
                                            <FontIcon FontSize="12" Glyph="&#xED1A;" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock FontFamily="Consolas" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind CommandLine}" Visibility="{x:Bind CanStart}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="Start_Click" IsEnabled="{x:Bind StartEnabled, Mode=OneWay}" Tag="{x:Bind}" Visibility="{x:Bind helpers:Bind.Collapsed(IsRunning), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                                                <TextBlock Text="Start" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Stop_Click" Tag="{x:Bind}" Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Foreground="{x:Bind helpers:Bind.Danger}" Glyph="&#xE71A;" />
                                                <TextBlock Text="Stop" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Open_Click" Tag="{x:Bind}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE838;" />
                                                <TextBlock Text="Open folder" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Url_Click" Tag="{x:Bind}" Visibility="{x:Bind HasUrl}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                                <TextBlock Text="Open URL" />
                                            </StackPanel>
                                        </Button>
                                        <ToggleButton Content="Log" IsChecked="{x:Bind IsLogOpen, Mode=TwoWay}" />
                                    </StackPanel>
                                    <Border Height="180" Style="{StaticResource ConsoleStyle}" Visibility="{x:Bind IsLogOpen, Mode=OneWay}">
                                        <ListView
                                            helpers:AutoScroll.IsEnabled="True"
                                            ItemContainerStyle="{StaticResource ConsoleListItemStyle}"
                                            ItemsSource="{x:Bind Logs}"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Foreground="{Binding Converter={StaticResource DashboardLogBrushConverter}}" Style="{StaticResource ConsoleTextStyle}" Text="{x:Bind}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind helpers:Bind.VisibleIfAny(ViewModel.HiddenCount), Mode=OneWay}">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}">
                <Run Text="{x:Bind ViewModel.HiddenCount, Mode=OneWay}" />
                <Run Text="hidden" />
            </TextBlock>
            <HyperlinkButton Click="ShowAll_Click" Content="Show all" />
        </StackPanel>
    </Grid>
</Page>
