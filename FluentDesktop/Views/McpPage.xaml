<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentDesktop.Views.McpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FluentDesktop.Helpers"
    xmlns:vm="using:FluentDesktop.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="MCP Servers" />
                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="One server list, synced to Claude, Codex, Gemini, Grok, OpenCode, Hermes, Pi and MiniMax." />
            </StackPanel>
            <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <Button Grid.Column="2" Click="Import_Click" ToolTipService.ToolTip="Read every app's config and adopt its servers">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                    <TextBlock Text="Import from apps" />
                </StackPanel>
            </Button>
            <SplitButton Grid.Column="3" Click="Add_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Add MCP" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Click="Rewrite_Click" Text="Rewrite every app's config">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="CopyAll_Click" Text="Copy all as mcpServers JSON">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>

        <AutoSuggestBox Grid.Row="1" PlaceholderText="Search name, command, or URL" QueryIcon="Find" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Border Grid.Row="2" Padding="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:McpColumn">
                                <Button
                                    Width="72"
                                    Padding="2,4"
                                    Click="Column_Click"
                                    Content="{x:Bind Label}"
                                    FontSize="12"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind ToolTip}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <Grid>
                        <StackPanel
                            Margin="0,48"
                            HorizontalAlignment="Center"
                            Spacing="6"
                            Visibility="{x:Bind helpers:Bind.VisibleIfNone(ViewModel.Rows.Count), Mode=OneWay}">
                            <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE703;" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="No MCP servers" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="Add one, pick a template, or import what your apps already use." />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:McpRow">
                                    <Grid Padding="16,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="132" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Id}" />
                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Style="{StaticResource PillBorderStyle}">
                                                    <TextBlock FontSize="10" Text="{x:Bind Transport}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontFamily="Consolas" MaxLines="1" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Summary}" />
                                        </StackPanel>
                                        <ItemsRepeater Grid.Column="1" VerticalAlignment="Center" ItemsSource="{x:Bind Cells}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:McpCell">
                                                    <Grid Width="72">
                                                        <CheckBox
                                                            MinWidth="0"
                                                            HorizontalAlignment="Center"
                                                            Click="Cell_Click"
                                                            IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="{x:Bind ToolTip}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                                            <Button Click="Edit_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Edit">
                                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                            </Button>
                                            <Button Click="CopyRow_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Copy as JSON">
                                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                            </Button>
                                            <Button Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="More">
                                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="DisableAll_Click" Tag="{x:Bind}" Text="Turn off everywhere" />
                                                        <MenuFlyoutItem Click="Delete_Click" Tag="{x:Bind}" Text="Delete">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource SecondaryCaptionStyle}" Text="Toggles write straight to each app's config file. Turning an app off removes the server from it. Uninstalled apps (except Pi and MiniMax) are never written to." />
    </Grid>
</Page>
