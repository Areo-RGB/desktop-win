<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentDesktop.Views.YtDlpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentDesktop.Controls"
    xmlns:helpers="using:FluentDesktop.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:FluentDesktop.Views"
    xmlns:vm="using:FluentDesktop.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="FolderTemplate" x:DataType="vm:FolderEntry">
            <Grid Padding="0,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" Padding="6,0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
                    <TextBlock FontSize="11" Text="{x:Bind Count}" />
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HistoryTemplate" x:DataType="vm:HistoryEntry">
            <Grid Padding="0,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Height="54" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6">
                    <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8B2;" />
                    <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock MaxLines="2" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Subtitle}" />
                </StackPanel>
                <Button Grid.Column="2" Click="OpenHistory_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Open file location">
                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="36,24,36,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE896;" />
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="YDL GUI" />
                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="Paste a video link, inspect it, and download instantly." />
                </StackPanel>
            </StackPanel>
            <Border HorizontalAlignment="Right" BorderBrush="{x:Bind views:YtBind.StatusBrush(ViewModel.IsAvailable), Mode=OneWay}" Style="{StaticResource PillBorderStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="{x:Bind views:YtBind.StatusBrush(ViewModel.IsAvailable), Mode=OneWay}" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind views:YtBind.StatusBrush(ViewModel.IsAvailable), Mode=OneWay}" Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <SelectorBar x:Name="Tabs" Grid.Row="1" Margin="28,8,28,0" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem IsSelected="True" Text="Downloader" />
            <SelectorBarItem Text="Local Files" />
            <SelectorBarItem Text="Cloud Files" />
        </SelectorBar>

        <InfoBar
            Grid.Row="2"
            Margin="36,12,36,0"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="{x:Bind views:YtBind.Severity(ViewModel.IsError), Mode=OneWay}" />

        <!--  Downloader  -->
        <ScrollViewer x:Name="DownloaderPanel" Grid.Row="3">
            <controls:CenteredColumn MaxContentWidth="960">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="UrlBox"
                            Header="Video URL"
                            InputScope="Url"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            KeyDown="Url_KeyDown"
                            PlaceholderText="https://www.youtube.com/watch?v=…"
                            Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="Parse_Click" IsEnabled="{x:Bind ViewModel.CanParse, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid Width="16" Height="16">
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingInfo, Mode=OneWay}" />
                                    <FontIcon FontSize="14" Glyph="&#xE721;" Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.IsLoadingInfo), Mode=OneWay}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.ParseLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Button Click="Paste_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE77F;" />
                            <TextBlock Text="Paste from clipboard" />
                        </StackPanel>
                    </Button>
                    <Button Click="History_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE81C;" />
                            <TextBlock Text="{x:Bind ViewModel.HistoryLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <toolkit:SettingsExpander Header="Embedding options" IsExpanded="True">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.ItemsHeader>
                        <StackPanel Padding="58,8,16,8" Orientation="Horizontal" Spacing="18">
                            <CheckBox Content="Subtitles" IsChecked="{x:Bind ViewModel.EmbedSubs, Mode=TwoWay}" />
                            <CheckBox Content="Thumbnail" IsChecked="{x:Bind ViewModel.EmbedThumbnail, Mode=TwoWay}" />
                            <CheckBox Content="Metadata" IsChecked="{x:Bind ViewModel.EmbedMetadata, Mode=TwoWay}" />
                            <CheckBox Content="Chapters" IsChecked="{x:Bind ViewModel.EmbedChapters, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsExpander.ItemsHeader>
                </toolkit:SettingsExpander>

                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Download options" />
                    <toolkit:SettingsCard Header="Format mode">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B2;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="240" ItemsSource="{x:Bind ViewModel.DownloadTypes}" SelectedIndex="{x:Bind ViewModel.DownloadTypeIndex, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Video quality" Visibility="{x:Bind ViewModel.IsVideoMode, Mode=OneWay}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE714;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="240" ItemsSource="{x:Bind ViewModel.Qualities}" SelectedIndex="{x:Bind ViewModel.QualityIndex, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Audio format" Visibility="{x:Bind ViewModel.IsAudioMode, Mode=OneWay}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D6;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="240" ItemsSource="{x:Bind ViewModel.AudioFormats}" SelectedIndex="{x:Bind ViewModel.AudioFormatIndex, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Playlist mode">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE90B;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="240" ItemsSource="{x:Bind ViewModel.PlaylistModes}" SelectedIndex="{x:Bind ViewModel.PlaylistIndex, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Click="OutputFolder_Click" Description="{x:Bind ViewModel.OutputDir, Mode=OneWay}" Header="Output folder" IsClickEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE838;" />
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                </StackPanel>

                <!--  Video card  -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind helpers:Bind.VisibleIfNotNull(ViewModel.VideoInfo), Mode=OneWay}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="146" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
                            <FontIcon FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8B2;" />
                            <Image Source="{x:Bind ViewModel.VideoThumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock MaxLines="3" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.VideoInfo.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.VideoMeta, Mode=OneWay}" />
                            <Button Click="Download_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                                    <TextBlock Text="Start download" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Progress  -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowProgress, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Progress.Status, Mode=OneWay}" />
                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind views:YtBind.Percent(ViewModel.Progress.Percent), Mode=OneWay}" />
                        </Grid>
                        <ProgressBar Height="10" Maximum="100" Value="{x:Bind ViewModel.Progress.Percent, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}">
                            <Run Text="Speed:" /> <Run Text="{x:Bind ViewModel.Progress.Speed, Mode=OneWay}" />
                            <Run Text="   Size:" /> <Run Text="{x:Bind ViewModel.Progress.TotalSize, Mode=OneWay}" />
                            <Run Text="   ETA:" /> <Run Text="{x:Bind ViewModel.Progress.Eta, Mode=OneWay}" />
                        </TextBlock>
                        <HyperlinkButton Click="CancelDownload_Click" Foreground="{x:Bind helpers:Bind.Danger}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE71A;" />
                                <TextBlock Text="Cancel download" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </Border>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowUnavailable, Mode=OneWay}"
                    Message="Install yt-dlp (winget install yt-dlp.yt-dlp) and ensure it is available on PATH to enable parsing and downloads."
                    Severity="Informational" />

                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="yt-dlp handles the download locally. Files are saved to the selected folder." />
            </StackPanel>
            </controls:CenteredColumn>
        </ScrollViewer>

        <!--  Local files  -->
        <Grid x:Name="LocalPanel" Grid.Row="3" Padding="{StaticResource PagePadding}" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <toolkit:SettingsCard Description="{x:Bind ViewModel.LocalRoot, Mode=OneWay}" Header="Local files">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8F1;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.UploadStatus, Mode=OneWay}" />
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingLocal, Mode=OneWay}" />
                    <Button Click="RefreshLocal_Click" Content="Refresh" IsEnabled="{x:Bind helpers:Bind.Not(ViewModel.IsLoadingLocal), Mode=OneWay}" />
                    <Button Click="ChooseRoot_Click" Content="Choose root" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </toolkit:SettingsCard>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="12" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox PlaceholderText="Search folders" QueryIcon="Find" Text="{x:Bind ViewModel.LocalSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ListView Grid.Row="1" ItemTemplate="{StaticResource FolderTemplate}" ItemsSource="{x:Bind ViewModel.LocalFolders}" SelectedItem="{x:Bind ViewModel.SelectedLocalFolder, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Padding="12" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE838;" />
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedLocalTitle, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                                <Button Click="OpenLocalFolder_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Open folder">
                                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                                </Button>
                                <Button Click="UploadFolder_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Upload folder to R2">
                                    <FontIcon FontSize="14" Glyph="&#xE898;" />
                                </Button>
                                <Button Click="DeleteLocalFolder_Click" IsEnabled="{x:Bind ViewModel.CanDeleteLocalFolder, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Delete folder">
                                    <FontIcon FontSize="14" Foreground="{x:Bind helpers:Bind.Danger}" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No videos" Visibility="{x:Bind helpers:Bind.VisibleIfNone(ViewModel.LocalMedia.Count), Mode=OneWay}" />
                        <GridView Grid.Row="1" IsItemClickEnabled="True" ItemClick="LocalMedia_ItemClick" ItemsSource="{x:Bind ViewModel.LocalMedia}" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MediaEntry">
                                    <Grid Width="240" Height="200" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <FontIcon FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8B2;" Visibility="{x:Bind NoThumbnail, Mode=OneWay}" />
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                            <Border Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#8A000000" CornerRadius="18">
                                                <FontIcon FontSize="14" Foreground="White" Glyph="&#xE768;" />
                                            </Border>
                                            <Border Margin="8" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#8A000000" CornerRadius="4" Visibility="{x:Bind helpers:Bind.VisibleIfText(Badge), Mode=OneWay}">
                                                <TextBlock FontSize="11" Foreground="White" Text="{x:Bind Badge, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Padding="10,6,4,4">
                                            <TextBlock FontWeight="SemiBold" MaxLines="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Subtitle}" TextWrapping="NoWrap" />
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Padding="6" Click="CopyLocalPath_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Copy path">
                                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                    </Button>
                                                    <Button Padding="6" Click="UploadLocal_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Upload to R2">
                                                        <FontIcon FontSize="12" Glyph="&#xE898;" />
                                                    </Button>
                                                    <Button Padding="6" Click="DeleteLocal_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Delete">
                                                        <FontIcon FontSize="12" Foreground="{x:Bind helpers:Bind.Danger}" Glyph="&#xE74D;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  Cloud files  -->
        <Grid x:Name="CloudPanel" Grid.Row="3" Padding="{StaticResource PagePadding}" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <toolkit:SettingsCard Description="{x:Bind ViewModel.R2Label, Mode=OneWay}" Header="Cloud files (Cloudflare R2)">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE753;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingCloud, Mode=OneWay}" />
                    <Button Click="RefreshCloud_Click" Content="Refresh" IsEnabled="{x:Bind helpers:Bind.Not(ViewModel.IsLoadingCloud), Mode=OneWay}" />
                    <Button Click="R2Settings_Click" Content="R2 settings" />
                </StackPanel>
            </toolkit:SettingsCard>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="12" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox PlaceholderText="Search folders" QueryIcon="Find" Text="{x:Bind ViewModel.CloudSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ListView Grid.Row="1" ItemTemplate="{StaticResource FolderTemplate}" ItemsSource="{x:Bind ViewModel.CloudFolders}" SelectedItem="{x:Bind ViewModel.SelectedCloudFolder, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Padding="12" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE838;" />
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedCloudTitle, Mode=OneWay}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Click="DeleteCloudFolder_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Delete folder objects">
                                <FontIcon FontSize="14" Foreground="{x:Bind helpers:Bind.Danger}" Glyph="&#xE74D;" />
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No videos" Visibility="{x:Bind helpers:Bind.VisibleIfNone(ViewModel.CloudMedia.Count), Mode=OneWay}" />
                        <GridView Grid.Row="1" IsItemClickEnabled="True" ItemClick="CloudMedia_ItemClick" ItemsSource="{x:Bind ViewModel.CloudMedia}" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MediaEntry">
                                    <Grid Width="240" Height="200" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <FontIcon FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE753;" />
                                            <Border Margin="8" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#8A000000" CornerRadius="4">
                                                <TextBlock FontSize="11" Foreground="White" Text="R2" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Padding="10,6,4,4">
                                            <TextBlock FontWeight="SemiBold" MaxLines="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Subtitle}" TextWrapping="NoWrap" />
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Padding="6" Click="CopyCloudUrl_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Copy URL">
                                                        <FontIcon FontSize="12" Glyph="&#xE71B;" />
                                                    </Button>
                                                    <Button Padding="6" Click="DeleteCloud_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Delete">
                                                        <FontIcon FontSize="12" Foreground="{x:Bind helpers:Bind.Danger}" Glyph="&#xE74D;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
