<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentDesktop.Views.DesktopCommanderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentDesktop.Controls"
    xmlns:helpers="using:FluentDesktop.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:FluentDesktop.Views"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <controls:CenteredColumn MaxContentWidth="960">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Desktop Commander Remote MCP" />
                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="Launch and authorize Desktop Commander as a remote MCP device." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Start_Click" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="Start Desktop Commander" />
                    </StackPanel>
                </Button>
                <Button Click="Stop_Click" IsEnabled="{x:Bind ViewModel.ProcessActive, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE71A;" />
                        <TextBlock Text="Disconnect" />
                    </StackPanel>
                </Button>
                <Button Click="Reauthorize_Click" IsEnabled="{x:Bind ViewModel.CanReauthorize, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="14" Height="14">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsReauthorizing, Mode=OneWay}" />
                            <FontIcon FontSize="14" Glyph="&#xE72C;" Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.IsReauthorizing), Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="Re-Authorize" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Status  -->
            <Border Style="{StaticResource SubtleCardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Status" />
                        <Border
                            HorizontalAlignment="Right"
                            BorderBrush="{x:Bind views:DesktopCommanderBind.StatusBrush(ViewModel.Status), Mode=OneWay}"
                            Style="{StaticResource PillBorderStyle}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{x:Bind views:DesktopCommanderBind.StatusBrush(ViewModel.Status), Mode=OneWay}"
                                Text="{x:Bind views:DesktopCommanderBind.StatusLabel(ViewModel.Status), Mode=OneWay}" />
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsWorking, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind helpers:Bind.VisibleIfNotNull(ViewModel.AuthUrl), Mode=OneWay}">
                        <Border
                            Padding="12,6"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{x:Bind helpers:Bind.VisibleIfNotNull(ViewModel.AuthCode), Mode=OneWay}">
                            <TextBlock
                                CharacterSpacing="150"
                                FontWeight="Bold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.AuthCode, Mode=OneWay}" />
                        </Border>
                        <Button VerticalAlignment="Center" Click="OpenLink_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                <TextBlock Text="Open Link" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Visibility="{x:Bind helpers:Bind.VisibleIfNotNull(ViewModel.DeviceId), Mode=OneWay}">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Device ID" />
                        <TextBlock Style="{StaticResource MonoCaptionStyle}" Text="{x:Bind ViewModel.DeviceId, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Settings  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Authorization Settings" />
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <toolkit:SettingsCard Description="Use agent-browser to submit the pairing code automatically." Header="Automatic browser verification">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AutoVerify, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="agent-browser --profile" Header="Chrome profile">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TextBox MinWidth="220" PlaceholderText="Default" Text="{x:Bind ViewModel.ChromeProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="1–300 seconds per browser step" Header="Verification timeout">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <NumberBox
                        MinWidth="140"
                        Maximum="300"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.VerificationTimeout, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>
            <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.SettingsHint, Mode=OneWay}" />

            <!--  Console  -->
            <Grid>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Live Console" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.LogCount, Mode=OneWay}" />
                    <Button Click="ClearLogs_Click" Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE894;" />
                            <TextBlock Text="Clear Logs" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Height="320" Style="{StaticResource ConsoleStyle}">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#888888"
                        Text="Desktop Commander output will appear here."
                        Visibility="{x:Bind helpers:Bind.VisibleIfNone(ViewModel.Logs.Count), Mode=OneWay}" />
                    <ListView
                        helpers:AutoScroll.IsEnabled="True"
                        ItemContainerStyle="{StaticResource ConsoleListItemStyle}"
                        ItemsSource="{x:Bind ViewModel.Logs}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Foreground="{Binding Converter={StaticResource DesktopCommanderLogBrushConverter}}" Style="{StaticResource ConsoleTextStyle}" Text="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </StackPanel>
        </controls:CenteredColumn>
    </ScrollViewer>
</Page>
