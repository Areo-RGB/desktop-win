<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentDesktop.Views.SkillsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FluentDesktop.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:FluentDesktop.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Skills" />
                <TextBlock Style="{StaticResource SecondaryCaptionStyle}">
                    <Run Text="Git-backed skills for Pi, Claude Code, Codex and OpenCode in" />
                    <Run Text="{x:Bind ViewModel.RepoDir}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.IsIdle), Mode=OneWay}">
                <ProgressRing Width="16" Height="16" IsActive="True" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.Busy, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="2" Click="Refresh_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" ToolTipService.ToolTip="Pull upstream changes and push local ones">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Click="New_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="New skill" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" ToolTipService.ToolTip="Import and backups">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                    <TextBlock Text="Import" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Click="ImportFolder_Click" Text="Import folder…" />
                        <MenuFlyoutItem Click="ImportApps_Click" Text="Import from apps" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="Backups_Click" Text="Backups…" />
                        <MenuFlyoutItem Click="OpenRepo_Click" Text="Open repository folder" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind helpers:Bind.HasText(ViewModel.Status), Mode=OneWay}"
            Message="{x:Bind ViewModel.Status, Mode=OneWay}"
            Severity="{x:Bind helpers:Bind.Severity(ViewModel.StatusIsError), Mode=OneWay}" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search skills" QueryIcon="Find" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <toolkit:Segmented Grid.Column="1" SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}">
                <toolkit:SegmentedItem Content="All" />
                <toolkit:SegmentedItem Content="Disabled" />
                <toolkit:SegmentedItem Content="Pi" />
                <toolkit:SegmentedItem Content="Claude" />
                <toolkit:SegmentedItem Content="Codex" />
                <toolkit:SegmentedItem Content="OpenCode" />
            </toolkit:Segmented>
        </Grid>

        <Grid Grid.Row="3" Padding="16,6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
            <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkillColumn">
                        <Button
                            Width="80"
                            Padding="2,4"
                            Click="Column_Click"
                            Content="{x:Bind Label}"
                            FontSize="12"
                            Style="{StaticResource SubtleButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="Toggle this app for every shown skill" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>

        <ScrollViewer Grid.Row="4">
            <Grid>
                <TextBlock
                    Margin="0,40"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryCaptionStyle}"
                    Text="No skills to show. Create a skill, import a folder containing SKILL.md, or change the filter."
                    Visibility="{x:Bind helpers:Bind.VisibleIfNone(ViewModel.Rows.Count), Mode=OneWay}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkillRow">
                            <Grid Padding="16,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" ColumnSpacing="4" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock MaxLines="2" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ItemsRepeater Grid.Column="1" VerticalAlignment="Center" ItemsSource="{x:Bind Cells}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SkillCell">
                                            <Grid Width="80">
                                                <CheckBox
                                                    MinWidth="0"
                                                    HorizontalAlignment="Center"
                                                    Click="Cell_Click"
                                                    IsChecked="{x:Bind IsEnabled}"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="{x:Bind ToolTip}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                    <Button Click="Edit_Click" Content="Edit" Tag="{x:Bind}" />
                                    <Button Click="Uninstall_Click" Content="Uninstall…" Tag="{x:Bind}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
