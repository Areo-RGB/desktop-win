<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentDesktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FluentDesktop.Helpers"
    xmlns:views="using:FluentDesktop.Views"
    xmlns:vm="using:FluentDesktop.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Command Runner Dashboard" />
                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="Click a command to run it. Output streams into the terminal. Right-click to edit." />
            </StackPanel>
            <Button Grid.Column="1" Click="Add_Click" ToolTipService.ToolTip="Add command">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Add" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Click="Reload_Click" ToolTipService.ToolTip="Reload commands from JSON">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <Grid Grid.Row="1" ColumnSpacing="16" Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.IsLoading), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Command list  -->
            <ScrollViewer>
                <StackPanel Spacing="8">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Commands}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DashboardCommandItem">
                                <Button
                                    Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    BorderBrush="{x:Bind views:DashboardBind.BorderFor(IsRunning, IsSelected), Mode=OneWay}"
                                    BorderThickness="1"
                                    Click="Run_Click"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind CommandString}">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="Edit_Click" Tag="{x:Bind}" Text="Edit Command">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE70F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="Delete_Click" Tag="{x:Bind}" Text="Delete Command">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="24" Height="24">
                                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind IsRunning, Mode=OneWay}" />
                                            <Image Source="{x:Bind Icon}" Visibility="{x:Bind helpers:Bind.AndNotVisible(HasIcon, IsRunning), Mode=OneWay}" />
                                            <FontIcon
                                                FontSize="18"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE756;"
                                                Visibility="{x:Bind helpers:Bind.NoneVisible(HasIcon, IsRunning), Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource SecondaryCaptionStyle}" MaxLines="1" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Padding="6"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="Delete_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Delete">
                                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button
                        Padding="10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="Add_Click"
                        Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE710;" />
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Add Command" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!--  Console  -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Foreground="{x:Bind views:DashboardBind.StatusBrush(ViewModel.StatusKind), Mode=OneWay}" Glyph="{x:Bind views:DashboardBind.StatusGlyph(ViewModel.StatusKind), Mode=OneWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="Execution Output:" />
                                <Run Text="{x:Bind ViewModel.SessionTitle, Mode=OneWay}" />
                            </TextBlock>
                            <Border BorderBrush="{x:Bind views:DashboardBind.StatusBrush(ViewModel.StatusKind), Mode=OneWay}" Style="{StaticResource PillBorderStyle}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind views:DashboardBind.StatusBrush(ViewModel.StatusKind), Mode=OneWay}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="2" Click="Cancel_Click" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Foreground="{x:Bind helpers:Bind.Danger}" Glyph="&#xE71A;" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="3"
                            Click="Dismiss_Click"
                            IsEnabled="{x:Bind helpers:Bind.Not(ViewModel.IsRunning), Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Dismiss console">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" MinHeight="420" Style="{StaticResource ConsoleStyle}">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#888888"
                                Text="Select a command to see terminal output here."
                                Visibility="{x:Bind ViewModel.NoSession, Mode=OneWay}" />
                            <ListView
                                helpers:AutoScroll.IsEnabled="True"
                                ItemContainerStyle="{StaticResource ConsoleListItemStyle}"
                                ItemsSource="{x:Bind ViewModel.Logs}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Foreground="{Binding Converter={StaticResource DashboardLogBrushConverter}}" Style="{StaticResource ConsoleTextStyle}" Text="{x:Bind}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
