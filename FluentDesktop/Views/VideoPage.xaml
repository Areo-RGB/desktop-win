<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentDesktop.Views.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FluentDesktop.Helpers"
    xmlns:vm="using:FluentDesktop.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="36,24,36,0">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Video" />
            <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="Chapter metadata (stream copy), HEVC re-encode with keyframes at every chapter, and the Training Hub R2 bucket. Downloads live on the YT-DLP page." />
        </StackPanel>

        <SelectorBar x:Name="Tabs" Grid.Row="1" Margin="28,8,28,0" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem IsSelected="True" Text="Edit video" />
            <SelectorBarItem Text="R2" />
        </SelectorBar>

        <!--  Edit  -->
        <ScrollViewer x:Name="EditPanel" Grid.Row="2">
            <StackPanel Padding="36,12,36,24" Spacing="12">
                <!--  Local library  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Local videos" />
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.LibraryText, Mode=OneWay}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="Scan_Click" IsEnabled="{x:Bind helpers:Bind.Not(ViewModel.IsScanning), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Grid Width="14" Height="14">
                                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.IsScanning), Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Text="Scan folder" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ScrollViewer MaxHeight="300">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.LocalVideos}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="8" MinItemWidth="180" MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LocalVideoItem">
                                        <Button
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            BorderBrush="{x:Bind helpers:Bind.SelectedBorder(IsSelected), Mode=OneWay}"
                                            BorderThickness="2"
                                            Click="Local_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind Path}">
                                            <StackPanel>
                                                <Grid Height="100" Background="{ThemeResource ConsoleBackgroundBrush}">
                                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Grid>
                                                <StackPanel Padding="8,6">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Size}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!--  File  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="File" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox KeyDown="File_KeyDown" PlaceholderText="Video file (.mp4, .mov, .mkv)" Text="{x:Bind ViewModel.FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Click="Browse_Click" Content="Browse…" />
                            <Button Grid.Column="2" Click="Read_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Foreground="White" />
                                    <TextBlock Text="Read" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.InfoText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasInfo, Mode=OneWay}">
                    <!--  Chapters  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Chapters" />
                                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.ChapterSummary, Mode=OneWay}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Click="Play_Click" ToolTipService.ToolTip="Open in the default player">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                                        <TextBlock Text="Play" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Chapters}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChapterRow">
                                        <Grid Padding="0,3" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="Consolas" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Range}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!--  Editor  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Chapters JSON" />
                                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="start and end in milliseconds · empty removes all chapters" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button Click="Template_Click" Content="Copy template" />
                                    <Button Click="Reset_Click" Content="Use file’s chapters" />
                                </StackPanel>
                            </Grid>
                            <TextBox
                                MinHeight="160"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                PlaceholderText="[{&quot;name&quot;: …, &quot;start&quot;: ms, &quot;end&quot;: ms}]"
                                Text="{x:Bind ViewModel.ChaptersText, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <CheckBox Content="Remove all other metadata tags (title, artist, …)" IsChecked="{x:Bind ViewModel.StripTags, Mode=TwoWay}" />
                            <Button Click="Write_Click" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Rewrite the file in place without re-encoding; old chapters are replaced">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                    <TextBlock Text="Write metadata" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--  Encode  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Re-encode with chapter keyframes" />
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="H.265 with a keyframe at every chapter start and end, chapters written too" />
                            </StackPanel>
                            <TextBox Header="Output file" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox MinWidth="180" Header="Encoder" SelectedIndex="{x:Bind ViewModel.EncoderIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="GPU (NVENC)" />
                                    <ComboBoxItem Content="CPU (x265)" />
                                </ComboBox>
                                <NumberBox
                                    Grid.Column="1"
                                    Header="Quality (CQ / CRF, lower is better)"
                                    IsEnabled="{x:Bind helpers:Bind.Not(ViewModel.MatchSource), Mode=OneWay}"
                                    Maximum="51"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.Quality, Mode=TwoWay}" />
                                <NumberBox
                                    Grid.Column="2"
                                    Header="Extra keyframe every (seconds)"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.GopSeconds, Mode=TwoWay}" />
                            </Grid>
                            <CheckBox Content="Match original: same bitrate, bit depth, colours and frame timing as the source" IsChecked="{x:Bind ViewModel.MatchSource, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="Encode_Click" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE714;" />
                                        <TextBlock Text="Re-encode" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  R2  -->
        <ScrollViewer x:Name="R2Panel" Grid.Row="2" Visibility="Collapsed">
            <StackPanel Padding="36,12,36,24" Spacing="12">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Bucket" />
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ViewModel.BucketText, Mode=OneWay}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="ConfigFolder_Click" Content="r2.properties…" ToolTipService.ToolTip="Credentials live in r2.properties in the config folder (r2.accountId, r2.bucket, r2.accessKeyId, r2.secretAccessKey)" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox KeyDown="Prefix_KeyDown" PlaceholderText="Prefix, e.g. videos-training/" Text="{x:Bind ViewModel.Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Click="List_Click" IsEnabled="{x:Bind helpers:Bind.Not(ViewModel.IsListing), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Grid Width="14" Height="14">
                                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsListing, Mode=OneWay}" />
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.IsListing), Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Text="List" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Objects}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:R2ObjectItem">
                                    <Grid Padding="0,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Key}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1" FontSize="12" Foreground="{x:Bind helpers:Bind.Success}" Glyph="&#xE73E;" ToolTipService.ToolTip="Same file in the local folder" Visibility="{x:Bind LocalMatch}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Size}" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Modified}" />
                                        <Button Grid.Column="4" Click="DeleteObject_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Delete from the bucket">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Upload a file" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="File to upload (into the prefix above)" Text="{x:Bind ViewModel.UploadFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Click="BrowseUpload_Click" Content="Browse…" />
                            <Button Grid.Column="2" Click="Upload_Click" Content="Upload" IsEnabled="{x:Bind ViewModel.NotUploading, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Local files" />
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="Tick videos to upload them one after another" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="Scan_Click" Content="Scan folder" IsEnabled="{x:Bind helpers:Bind.Not(ViewModel.IsScanning), Mode=OneWay}" />
                            <Button Grid.Column="2" Click="Batch_Click" IsEnabled="{x:Bind ViewModel.CanBatch, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}">
                                <TextBlock>
                                    <Run Text="Upload" />
                                    <Run Text="{x:Bind ViewModel.CheckedCount, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.LocalVideos}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocalVideoItem">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Size}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Job / upload status + log  -->
        <StackPanel Grid.Row="3" Padding="36,8,36,16" Spacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsJobRunning, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.JobLabel, Mode=OneWay}" />
                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Value="{x:Bind ViewModel.JobProgress, Mode=OneWay}" />
                <Button Grid.Column="2" Click="Cancel_Click" Content="Cancel" />
            </Grid>
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsUploading, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock MaxWidth="420" VerticalAlignment="Center" Text="{x:Bind ViewModel.UploadLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Value="{x:Bind ViewModel.UploadProgress, Mode=OneWay}" />
                <Button Grid.Column="2" Click="CancelUpload_Click" Content="Cancel" />
            </Grid>
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Log">
                <Border Height="180" Style="{StaticResource ConsoleStyle}">
                    <ListView
                        helpers:AutoScroll.IsEnabled="True"
                        ItemContainerStyle="{StaticResource ConsoleListItemStyle}"
                        ItemsSource="{x:Bind ViewModel.Logs}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Foreground="{Binding Converter={StaticResource LevelLogBrushConverter}}" Style="{StaticResource ConsoleTextStyle}" Text="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Expander>
        </StackPanel>
    </Grid>
</Page>
