<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 front end (Windows App SDK, unpackaged, self-contained).
       Project layout follows microsoft/WinUI-Gallery. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>FluentDesktop</RootNamespace>
    <AssemblyName>FluentDesktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <!-- CommunityToolkit.Mvvm field-based [ObservableProperty] AOT hint; not shipping AOT. -->
    <NoWarn>$(NoWarn);MVVMTK0045;CS8305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assets are embedded (loaded from memory by Helpers\Images) so the
         single-file exe needs nothing next to it. -->
    <Content Remove="Assets\**" />
    <None Remove="Assets\**" />
    <EmbeddedResource Include="Assets\**" LogicalName="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentDesktop.Core\FluentDesktop.Core.csproj" />
  </ItemGroup>

</Project>
